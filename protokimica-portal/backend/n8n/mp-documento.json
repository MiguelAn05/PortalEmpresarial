{
  "name": "Master Planner · documento para aprobar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-documento",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-mp-documento",
      "name": "Entra la notificación",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "mp-documento"
    },
    {
      "parameters": {
        "fromEmail": "recepcion@protokimica.com",
        "toEmail": "={{ $json.body.destinatario }}",
        "subject": "={{ $json.body.asunto }}",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 12px 0;font-size:19px;font-weight:600\">{{ $json.body.que_hacer }}</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\"><p style=\"margin:4px 0\"><span style=\"color:#8A93A9\">Tarea:</span> <strong style=\"color:#121A2B\">{{ $json.body.titulo }}</strong></p><p style=\"margin:4px 0\"><span style=\"color:#8A93A9\">Proyecto:</span> <strong style=\"color:#121A2B\">{{ $json.body.proyecto }}</strong></p><p style=\"margin:4px 0\"><span style=\"color:#8A93A9\">Documento:</span> <strong style=\"color:#121A2B\">{{ $json.body.documento }} (versión {{ $json.body.version }})</strong></p>{{ $json.body.paso ? '<p style=\"margin:4px 0\"><span style=\"color:#8A93A9\">Paso:</span> <strong style=\"color:#121A2B\">@@V@@</strong></p>'.replace('@@V@@', $json.body.paso) : '' }}{{ $json.body.quien ? '<p style=\"margin:4px 0\"><span style=\"color:#8A93A9\">Último movimiento:</span> <strong style=\"color:#121A2B\">@@V@@</strong></p>'.replace('@@V@@', $json.body.quien) : '' }}{{ $json.body.comentario ? '<p style=\"margin:14px 0 0 0;padding:12px;background:#EFF3F9;border-radius:8px\">' + $json.body.comentario + '</p>' : '' }}</div>\n  </td></tr>\n        <tr><td style=\"padding:8px 24px 24px 24px\">\n          <a href=\"{{ $json.body.link_portal }}\" style=\"display:inline-block;background:#0D2B5E;color:#ffffff;\n             text-decoration:none;padding:12px 22px;border-radius:8px;\n             font-weight:600;font-size:14px\">Abrir el documento</a>\n        </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {
          "ccEmail": "={{ ($json.body.en_copia || []).join(', ') }}"
        }
      },
      "id": "correo-mp-documento",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        260,
        0
      ]
    }
  ],
  "connections": {
    "Entra la notificación": {
      "main": [
        [
          {
            "node": "Enviar correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
