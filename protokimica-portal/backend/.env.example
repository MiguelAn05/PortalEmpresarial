# Copia este archivo a backend/.env ANTES de correr "docker compose up".
# Sin backend/.env el contenedor del backend no arranca (docker-compose.yml
# lo carga con env_file y la app lo exige en app/core/config.py).
#
# Los valores de abajo ya sirven tal cual para desarrollo local — solo
# cambia SECRET_KEY si quieres. Para el servidor se usa .env.prod
# (ver .env.prod.example), que es otro archivo distinto.

ENVIRONMENT=development

# La password debe coincidir con POSTGRES_PASSWORD del servicio "db"
# en docker-compose.yml.
DATABASE_URL=postgresql://protokimica:protokimica_dev_2026@db:5432/protokimica_portal
REDIS_URL=redis://redis:6379/0

# Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=clave_solo_para_desarrollo_cambiala_si_quieres

ACCESS_TOKEN_EXPIRE_MINUTES=480

# El frontend de desarrollo (Vite) corre en 5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# En desarrollo se deja una llave para poder usar POST /auth/register
REGISTER_SETUP_KEY=dev_setup_key

N8N_WEBHOOK_URL=http://n8n:5678/webhook
