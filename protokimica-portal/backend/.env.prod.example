# Copia este archivo a backend/.env.prod y rellena los valores reales.
# NO subas backend/.env.prod a git (ya debería estar en .gitignore).

ENVIRONMENT=production

# Debe coincidir con POSTGRES_PASSWORD del .env de la raíz
DATABASE_URL=postgresql://protokimica:CAMBIA_ESTA_PASSWORD@db:5432/protokimica_portal
REDIS_URL=redis://redis:6379/0

# Genera una clave larga y aleatoria, por ejemplo con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=https://portal.protokimica.com
FRONTEND_URL=https://portal.protokimica.com

# Déjalo vacío en producción una vez ya creaste el primer admin —
# así el endpoint /auth/register queda inservible sin esta llave.
REGISTER_SETUP_KEY=

N8N_WEBHOOK_URL=http://n8n:5678/webhook

# Dominios con los que se puede crear un usuario, separados por coma.
# El portal es interno: con un correo personal la persona no tiene buzón
# corporativo y no le llega nada del calendario ni de las notificaciones.
DOMINIOS_EMAIL_PERMITIDOS=protokimica.com

# ── Microsoft 365: tareas del Master Planner en el calendario de Outlook ──
# De la app registrada en Entra ID (Aplicaciones › Registros de aplicaciones).
# MS_CLIENT_SECRET es el "Valor" del secreto, NO el "Id. secreto".
# Con los tres vacíos la integración queda apagada y el portal funciona igual.
# Ojo: el secreto vence (máx. 24 meses) y ese día la sincronización se corta.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
