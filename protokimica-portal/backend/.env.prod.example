# Copia este archivo a backend/.env.prod y rellena los valores reales.
# NO subas backend/.env.prod a git (ya debería estar en .gitignore).

ENVIRONMENT=production

# Debe coincidir con POSTGRES_PASSWORD del .env de la raíz
DATABASE_URL=postgresql://protokimica:CAMBIA_ESTA_PASSWORD@db:5432/protokimica_portal
REDIS_URL=redis://redis:6379/0

# Genera una clave larga y aleatoria, por ejemplo con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=https://portal.protokimica.com
FRONTEND_URL=https://portal.protokimica.com

# Déjalo vacío en producción una vez ya creaste el primer admin —
# así el endpoint /auth/register queda inservible sin esta llave.
REGISTER_SETUP_KEY=

N8N_WEBHOOK_URL=http://n8n:5678/webhook
