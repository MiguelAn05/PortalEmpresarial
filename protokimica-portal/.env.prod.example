# Copia este archivo a ".env" en la raíz de protokimica-portal (mismo
# nivel que docker-compose.prod.yml) y rellena los valores reales.
# Docker Compose lo lee automáticamente si se llama ".env" — no hace
# falta pasarlo con --env-file.
# NO subas este archivo (ya con los valores reales) a git.

# Debe coincidir con la password que pongas en backend/.env.prod
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

N8N_USER=admin
N8N_PASSWORD=CAMBIA_ESTA_PASSWORD_TAMBIEN

# El token que te dio Cloudflare al crear el túnel "protokimica-portal"
# (Zero Trust → Networks → Tunnels → protokimica-portal → Overview →
# botón para copiar el comando de instalación, ahí viene el token)
CLOUDFLARE_TUNNEL_TOKEN=pega_aqui_el_token_completo
