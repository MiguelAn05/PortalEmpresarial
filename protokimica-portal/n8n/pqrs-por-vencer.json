{
  "name": "PQRS · por vencer el plazo de ley",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-pqrs-vencer",
      "name": "Cada mañana hábil",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "notes": "7 a.m. de lunes a viernes. En fin de semana no corre el plazo, así que avisar solo agrega ruido."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_slug\": \"protokimica\",\n  \"email\": \"automatizaciones@protokimica.com\",\n  \"password\": \"CAMBIAR-POR-LA-CLAVE-DEL-USUARIO-DE-SERVICIO\"\n}",
        "options": {}
      },
      "id": "login-pqrs-vencer",
      "name": "Entrar al portal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "notes": "Usa el usuario de servicio, nunca la cuenta de una persona."
    },
    {
      "parameters": {
        "url": "http://backend:8000/pqrs/por-vencer",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "dias",
              "value": "2"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "consulta-pqrs-vencer",
      "name": "Consultar las que vencen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "dias=2 son días HÁBILES: el backend ya descuenta fines de semana y festivos colombianos."
    },
    {
      "parameters": {
        "fieldToSplitOut": "destinatarios",
        "options": {}
      },
      "id": "split-pqrs-vencer",
      "name": "Una fila por persona",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 0],
      "notes": "El backend ya agrupó por responsable. Si no hay a quién avisarle, esto no produce filas y el flujo termina sin mandar nada."
    },
    {
      "parameters": {
        "fromEmail": "notificaciones@protokimica.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=PQRS por vencer · {{ $json.total }} caso{{ $json.total === 1 ? '' : 's' }} requieren tu atención",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 6px 0;font-size:19px;font-weight:600\">Hola {{ $json.nombre }}</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\">\n      {{ $json.vencidas > 0 ? 'Tienes ' + $json.vencidas + ' PQRS con el plazo <b style=\"color:#B32E2E\">ya vencido</b>' + ($json.total - $json.vencidas > 0 ? ' y ' + ($json.total - $json.vencidas) + ' a punto de vencerse' : '') + '.' : 'Tienes ' + $json.total + ' PQRS a punto de vencer el plazo.' }}\n      El plazo lo fija la Ley 1755 de 2015, así que no es una meta interna.\n    </div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;border-collapse:collapse\">\n      {{ $json.casos.map(c => '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#0D2B5E\">' + c.codigo + ' · ' + c.tipo + '</div><div style=\"font-size:13px;color:#55607A\">' + c.cliente + '</div><div style=\"font-size:13px;font-weight:600;color:' + (c.vencida ? '#B32E2E' : '#8A5D00') + '\">' + (c.vencida ? 'Venció hace ' + Math.abs(c.dias_restantes) + ' día(s) hábil(es)' : (c.dias_restantes === 0 ? 'Vence hoy' : 'Vence en ' + c.dias_restantes + ' día(s) hábil(es)')) + '</div></td></tr>').join('') }}\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:8px 24px 24px 24px\">\n    <a href=\"https://portal.protokimica.com/pqrs\" style=\"display:inline-block;background:#0D2B5E;color:#ffffff;\n       text-decoration:none;padding:12px 22px;border-radius:8px;\n       font-weight:600;font-size:14px\">Abrir mis PQRS</a>\n  </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {}
      },
      "id": "correo-pqrs-vencer",
      "name": "Avisar al responsable",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 0],
      "notes": "Cada quien recibe SOLO sus casos. Una lista con las de toda la empresa se archiva sin abrir."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "hay-huerfanas",
              "leftValue": "={{ $json.sin_responsable.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-huerfanas",
      "name": "¿Hay PQRS sin responsable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "fromEmail": "notificaciones@protokimica.com",
        "toEmail": "sacliente@protokimica.com",
        "subject": "=Atención: {{ $json.sin_responsable.length }} PQRS sin responsable y con el plazo corriendo",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 6px 0;font-size:19px;font-weight:600\">PQRS sin nadie a cargo</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\">\n      Estas solicitudes tienen el plazo corriendo y no tienen responsable asignado.\n      Mientras nadie las tome, el reloj sigue.\n    </div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;border-collapse:collapse\">\n      {{ $json.sin_responsable.map(c => '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#0D2B5E\">' + c.codigo + ' · ' + c.tipo + '</div><div style=\"font-size:13px;color:#55607A\">' + c.cliente + (c.area_responsable ? ' · ' + c.area_responsable : '') + '</div><div style=\"font-size:13px;font-weight:600;color:' + (c.vencida ? '#B32E2E' : '#8A5D00') + '\">' + (c.vencida ? 'Venció hace ' + Math.abs(c.dias_restantes) + ' día(s) hábil(es)' : (c.dias_restantes === 0 ? 'Vence hoy' : 'Vence en ' + c.dias_restantes + ' día(s) hábil(es)')) + '</div></td></tr>').join('') }}\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {}
      },
      "id": "correo-huerfanas",
      "name": "Avisar a Servicio al Cliente",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 200],
      "notes": "Las que no tienen dueño son las más peligrosas: el plazo corre y no hay quién responda."
    }
  ],
  "connections": {
    "Cada mañana hábil": {
      "main": [[{ "node": "Entrar al portal", "type": "main", "index": 0 }]]
    },
    "Entrar al portal": {
      "main": [[{ "node": "Consultar las que vencen", "type": "main", "index": 0 }]]
    },
    "Consultar las que vencen": {
      "main": [[
        { "node": "Una fila por persona", "type": "main", "index": 0 },
        { "node": "¿Hay PQRS sin responsable?", "type": "main", "index": 0 }
      ]]
    },
    "Una fila por persona": {
      "main": [[{ "node": "Avisar al responsable", "type": "main", "index": 0 }]]
    },
    "¿Hay PQRS sin responsable?": {
      "main": [[{ "node": "Avisar a Servicio al Cliente", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
