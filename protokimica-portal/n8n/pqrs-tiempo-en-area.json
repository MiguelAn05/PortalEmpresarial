        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 6px 0;font-size:19px;font-weight:600\">PQRS detenidas en áreas sin nadie activo</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\">\n      Estas PQRS llevan más de 3 días hábiles en un área donde no hay nadie\n      activo en el portal para atenderlas. Hay que pasarlas a quien sí pueda.\n    </div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;border-collapse:collapse\">\n      {{ $json.sin_destinatario.map(g => '<tr><td style=\"padding:12px 0 4px 0;font-size:13px;font-weight:600;color:#55607A\">' + g.area + '</td></tr>' + g.casos.map(c => '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#0D2B5E\">' + c.codigo + ' · ' + c.tipo + '</div><div style=\"font-size:13px;color:#55607A\">' + c.cliente + '</div><div style=\"font-size:13px;font-weight:600;color:' + (c.vencida ? '#B32E2E' : '#8A5D00') + '\">' + (c.vencida ? 'Lleva ' + c.dias_en_area + ' días hábiles en el área' : 'Hoy es su último día en el área') + '</div></td></tr>').join('')).join('') }}\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:8px 24px 24px 24px\">\n    <a href=\"https://portal.protokimica.com/pqrs\" style=\"display:inline-block;background:#0D2B5E;color:#ffffff;\n       text-decoration:none;padding:12px 22px;border-radius:8px;\n       font-weight:600;font-size:14px\">Abrir las PQRS</a>\n  </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {}
      },
      "id": "correo-pqrs-area-sin",
      "name": "Avisar a quien reparte",
