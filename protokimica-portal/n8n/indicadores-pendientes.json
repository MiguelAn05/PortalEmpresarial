{
  "name": "Indicadores · faltan por registrar",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 2,3,4 * *"
            }
          ]
        }
      },
      "id": "cron-indicadores",
      "name": "Días 2, 3 y 4",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "notes": "El registro cierra el día 3. Día 2 recuerda, día 3 es el último llamado y día 4 reporta a Calidad quién no cumplió."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_slug\": \"protokimica\",\n  \"email\": \"automatizaciones@protokimica.com\",\n  \"password\": \"CAMBIAR-POR-LA-CLAVE-DEL-USUARIO-DE-SERVICIO\"\n}",
        "options": {}
      },
      "id": "login-indicadores",
      "name": "Entrar al portal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "http://backend:8000/indicadores/pendientes-de-registro",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "consulta-indicadores",
      "name": "Consultar los que faltan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "Sin parámetros toma el último mes cerrado, que es justo el que se está registrando."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "es-dia-de-reporte",
              "leftValue": "={{ $now.day }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-dia",
      "name": "¿Ya pasó el plazo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "notes": "Antes del día 4 se recuerda a cada responsable. Del 4 en adelante ya no sirve recordar: toca reportar."
    },
    {
      "parameters": {
        "fromEmail": "notificaciones@protokimica.com",
        "toEmail": "calidad@protokimica.com",
        "subject": "=Indicadores sin registrar de {{ $json.mes_nombre }} · {{ $json.total }} pendientes",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 6px 0;font-size:19px;font-weight:600\">Cerró el plazo de {{ $json.mes_nombre }}</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\">\n      Quedaron <b>{{ $json.total }}</b> indicador(es) sin registrar después del día 3.\n    </div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;border-collapse:collapse\">\n      {{ $json.destinatarios.map(d => '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#0D2B5E\">' + d.nombre + ' · ' + d.total + ' pendiente(s)</div><div style=\"font-size:13px;color:#55607A\">' + d.indicadores.map(i => i.nombre).join(', ') + '</div></td></tr>').join('') }}\n      {{ $json.sin_responsable.length > 0 ? '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#B32E2E\">Sin responsable asignado · ' + $json.sin_responsable.length + '</div><div style=\"font-size:13px;color:#55607A\">' + $json.sin_responsable.map(i => i.nombre).join(', ') + '</div></td></tr>' : '' }}\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:8px 24px 24px 24px\">\n    <a href=\"https://portal.protokimica.com/indicadores\" style=\"display:inline-block;background:#0D2B5E;color:#ffffff;\n       text-decoration:none;padding:12px 22px;border-radius:8px;\n       font-weight:600;font-size:14px\">Ver el tablero</a>\n  </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {}
      },
      "id": "correo-calidad",
      "name": "Reportar a Calidad",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, -100],
      "notes": "Cierra el ciclo: un recordatorio que nadie revisa si se cumplió se vuelve paisaje en dos meses."
    },
    {
      "parameters": {
        "fieldToSplitOut": "destinatarios",
        "options": {}
      },
      "id": "split-indicadores",
      "name": "Una fila por responsable",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 120]
    },
    {
      "parameters": {
        "fromEmail": "notificaciones@protokimica.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=Te faltan {{ $json.total }} indicador{{ $json.total === 1 ? '' : 'es' }} por registrar",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html><body style=\"margin:0;padding:24px;background:#F3F6FB;\n  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#121A2B\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n  style=\"max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E2E8F2;\n  border-radius:12px;overflow:hidden\">\n  <tr><td style=\"padding:20px 24px;border-bottom:1px solid #E2E8F2\">\n    <span style=\"font-size:15px;font-weight:600;color:#0D2B5E\">Protokimica</span>\n    <span style=\"font-size:13px;color:#55607A\"> · Portal de gestión</span>\n  </td></tr>\n  <tr><td style=\"padding:24px 24px 8px 24px\">\n    <h1 style=\"margin:0 0 6px 0;font-size:19px;font-weight:600\">Hola {{ $json.nombre }}</h1>\n    <div style=\"font-size:14px;line-height:1.55;color:#55607A\">\n      {{ $now.day >= 3 ? 'Hoy es el último día para registrar los indicadores de ' : 'Estás a tiempo de registrar los indicadores de ' }}<b>{{ $('Consultar los que faltan').first().json.mes_nombre }}</b>.\n      Te faltan estos:\n    </div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:16px;border-collapse:collapse\">\n      {{ $json.indicadores.map(i => '<tr><td style=\"padding:10px 0;border-bottom:1px solid #EFF3F9\"><div style=\"font-size:14px;font-weight:600;color:#0D2B5E\">' + i.nombre + '</div>' + (i.area ? '<div style=\"font-size:13px;color:#55607A\">' + i.area + '</div>' : '') + '</td></tr>').join('') }}\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:8px 24px 24px 24px\">\n    <a href=\"https://portal.protokimica.com/indicadores\" style=\"display:inline-block;background:#0D2B5E;color:#ffffff;\n       text-decoration:none;padding:12px 22px;border-radius:8px;\n       font-weight:600;font-size:14px\">Registrar ahora</a>\n  </td></tr>\n  <tr><td style=\"padding:16px 24px;border-top:1px solid #E2E8F2;\n    font-size:12px;color:#8A93A9\">\n    Este mensaje es automático, no hace falta responderlo.\n  </td></tr>\n</table></body></html>",
        "options": {}
      },
      "id": "correo-responsable",
      "name": "Recordar al responsable",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1100, 120],
      "notes": "Cada quien recibe solo los suyos. La lista completa de la empresa no la lee nadie."
    }
  ],
  "connections": {
    "Días 2, 3 y 4": {
      "main": [[{ "node": "Entrar al portal", "type": "main", "index": 0 }]]
    },
    "Entrar al portal": {
      "main": [[{ "node": "Consultar los que faltan", "type": "main", "index": 0 }]]
    },
