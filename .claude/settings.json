{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(docker exec protokimica_backend pytest)",
      "Bash(docker exec protokimica_backend pytest *)",
      "Bash(docker exec protokimica_backend alembic upgrade *)",
      "Bash(docker exec protokimica_backend alembic current)",
      "Bash(docker exec protokimica_backend alembic heads)",
      "Bash(docker exec protokimica_backend alembic history *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npx eslint src)",
      "Bash(npx eslint src *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d *)"
    ]
  }
}
